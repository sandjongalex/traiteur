APP_ENV=development
APP_TIMEZONE=Africa/Douala

# Use a strong random value outside development.
SECRET_KEY=change-me-in-real-environment

# Current SQLite example (use an absolute path on PythonAnywhere):
DATABASE_URL=sqlite:////absolute/path/to/traiteur/instance/wato_events.db

# Future MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@host/database

# SQLite operational tuning. WAL is suitable for the current single-host MVP,
# but it does not remove SQLite's write-concurrency limits.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_ENABLED=1

WATO_COMPANY_NAME=WATO EVENTS
WATO_TAGLINE=Vos moments, notre savoir-faire.
WATO_CITY=Yaoundé
WATO_COUNTRY=Cameroun

# Leave optional contact fields empty until real values are available.
WATO_PHONE=
WATO_WHATSAPP=
WATO_EMAIL=
WATO_ADDRESS=
WATO_FACEBOOK_URL=
WATO_INSTAGRAM_URL=
WATO_TIKTOK_URL=
WATO_OG_IMAGE=

WATO_CURRENCY=XAF
MAX_CONTENT_LENGTH_MB=8
UPLOAD_FOLDER=app/static/uploads
